<!--
  YSVV rolling-window tree for Smac Hybrid-A* and RPP.
  Goal pruning and obstacle interval filtering are owned by the sender node.
  Smac performs its own kinematic smoothing, so this tree does not run the
  generic SimpleSmoother over the path a second time.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateYsvvRppWindow">
      <RecoveryNode number_of_retries="1" name="ComputeYsvvRppWindowPath">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                            service_name="global_costmap/clear_entirely_global_costmap"/>
      </RecoveryNode>
      <RecoveryNode number_of_retries="1" name="FollowYsvvRppWindowPath">
        <FollowPath path="{path}" controller_id="FollowPath"/>
        <ClearEntireCostmap name="ClearLocalCostmap-Context"
                            service_name="local_costmap/clear_entirely_local_costmap"/>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
