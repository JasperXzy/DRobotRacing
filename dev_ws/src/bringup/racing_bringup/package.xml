<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racing_bringup</name>
  <version>0.0.0</version>
  <description>Racing bringup package for competition workflows</description>
  <maintainer email="jasper.zhengyi.xu@gmail.com">JasperXzy</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>camera_driver</exec_depend>
  <exec_depend>lidar_driver</exec_depend>
  <exec_depend>chassis_driver</exec_depend>
  <exec_depend>origincar_description</exec_depend>
  <exec_depend>state_estimation</exec_depend>
  <exec_depend>line_detector</exec_depend>
  <exec_depend>perception_detector</exec_depend>
  <exec_depend>qr_detector_cpp</exec_depend>
  <exec_depend>vlm_tts_demo</exec_depend>
  <exec_depend>origincar_nav2</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
