<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>origincar_nav2</name>
  <version>0.0.0</version>
  <description>
    Custom navigation stack bringup and utilities for the origincar robot.
  </description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具依赖 -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 构建 (build) 和 导出构建 (build_export) 依赖 -->
  <!-- 如果包中包含C++代码，则需要这些依赖，但基于你的描述，可能不需要 -->
  <!-- <build_depend>example_package</build_depend> -->
  <!-- <build_export_depend>example_package</build_export_depend> -->

  <!-- 运行 (exec) 依赖 -->
  <!-- 1. ROS 2 核心通信库 -->
  <exec_depend>rclpy</exec_depend>

  <!-- 2. Nav2 核心包 -->
  <exec_depend>nav2_bringup</exec_depend>          <!-- 包含Nav2的主要启动文件 -->
  <exec_depend>navigation2</exec_depend>           <!-- Nav2的核心库 -->
  <exec_depend>nav2_msgs</exec_depend>             <!-- NavigateThroughPoses action -->
  <exec_depend>action_msgs</exec_depend>           <!-- ROS2 action result status -->

  <!-- 3. 机器人模型描述与坐标变换 -->
  <exec_depend>robot_state_publisher</exec_depend> <!-- 发布机器人模型TF -->
  <exec_depend>joint_state_publisher</exec_depend> <!-- 发布机器人关节状态 -->
  <exec_depend>joint_state_publisher_gui</exec_depend> <!-- 可选，用于调试的关节滑块 -->
  <exec_depend>xacro</exec_depend>                 <!-- 处理.xacro机器人模型文件 -->
  <exec_depend>tf2_ros</exec_depend>              <!-- TF坐标变换库 -->

  <!-- 4. 传感器驱动与消息 -->
  <exec_depend>ackermann_msgs</exec_depend>        <!-- 阿克曼转向消息 -->
  <exec_depend>geometry_msgs</exec_depend>         <!-- Twist等几何消息 -->
  <exec_depend>nav_msgs</exec_depend>              <!-- OccupancyGrid等导航消息 -->
  <exec_depend>sensor_msgs</exec_depend>           <!-- LaserScan等传感器消息 -->

  <!-- 5. 键盘控制节点 -->
  <exec_depend>teleop_twist_keyboard</exec_depend> <!-- 键盘控制 -->

  <!-- 6. 机器人定位与其他组件（用于EKF） -->
  <exec_depend>localization</exec_depend>    <!-- EKF定位包 -->

  <!-- 7. 工具与支持库 -->
  <exec_depend>launch</exec_depend>                <!-- 通用启动文件支持 -->
  <exec_depend>launch_ros</exec_depend>            <!-- ROS 2特定启动支持 -->
  <exec_depend>ament_index_python</exec_depend>    <!-- 资源查找工具 -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
