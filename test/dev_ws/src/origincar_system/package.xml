<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>origincar_system</name>
  <version>0.0.0</version>
  <description>Waypoint following with stored lidar-cluster waypoint shifts.</description>
  <maintainer email="1234567890@163.com">root</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ai_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rcutils</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- Runtime packages launched by the lidar_location/AMCL test bringups. -->
  <exec_depend>camera_driver</exec_depend>
  <exec_depend>chassis_driver</exec_depend>
  <exec_depend>lidar_driver</exec_depend>
  <exec_depend>line_detector</exec_depend>
  <exec_depend>perception_detector</exec_depend>
  <exec_depend>qr_detector_cpp</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>visual_control</exec_depend>
  <exec_depend>vlm_tts_demo</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>lidar_location</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
