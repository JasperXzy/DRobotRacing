<launch>
  <arg
    name="params_file"
    default="$(find-pkg-share origincar_system)/config/visual_lidar_path_follower.yaml"/>
  <arg
    name="waypoints_file"
    default="$(find-pkg-share origincar_system)/config/waypoints_qr.yaml"/>
  <arg
    name="route_waypoints_file"
    default="$(find-pkg-share origincar_system)/config/waypoints_channel.yaml"/>

  <node
    pkg="origincar_system"
    exec="visual_lidar_path_follower"
    name="visual_lidar_path_follower"
    output="screen">
    <param from="$(var params_file)"/>
    <param name="waypoints_file" value="$(var waypoints_file)"/>
    <param name="route_waypoints_file" value="$(var route_waypoints_file)"/>
  </node>
</launch>
