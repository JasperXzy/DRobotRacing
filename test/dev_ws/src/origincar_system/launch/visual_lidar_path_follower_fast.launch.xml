    name="params_file"
    default="$(find-pkg-share origincar_system)/config/visual_lidar_path_follower_fast.yaml"/>
  <include
    file="$(find-pkg-share origincar_system)/launch/visual_lidar_path_follower.launch.xml">
    <arg
      name="params_file"
      value="$(var params_file)"/>
  </include>
</launch>
