<launch>
  <!-- 坐标系与话题 -->
  <!-- 兼容旧流程的扫码前轨迹文件；默认 wait_for_qr_before_start=true 时不会使用它。 -->
  <arg name="waypoints_file" default="/root/D_Robot/test/dev_ws/src/origincar_system/config/waypoints_qr.yaml"/>
  <!-- 扫到 QR 后切换的环线文件；包含 clockwise/counterclockwise 两套路由。 -->
  <arg name="route_waypoints_file" default="/root/D_Robot/test/dev_ws/src/origincar_system/config/waypoints_ysvv_replaced.yaml"/>
  <!-- 全局定位坐标系；主线建图/AMCL 输出一般是 map。 -->
  <arg name="frame_id" default="map"/>
  <!-- 车体坐标系；控制节点通过 map -> base_link TF 读取车当前位置和朝向。 -->
  <arg name="base_frame_id" default="base_link"/>
  <!-- 速度输出话题；主线底盘驱动订阅 /cmd_vel。 -->
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <!-- 激光雷达话题；只用于转向避障，不负责定位。 -->
  <arg name="scan_topic" default="/scan"/>
  <!-- 静态地图话题；用于把已知墙体栅格从雷达避障点里过滤掉。 -->
  <arg name="map_topic" default="/map"/>
  <!-- 是否输出调试日志；false 时只保留初始化、QR、避障切换、终点和异常。 -->
  <arg name="debug_control_logs" default="true"/>
  <!-- true 时启动后只等待 QR，不跑 waypoints_file；二维码前由主线 visual_control 控制 /cmd_vel。 -->
  <arg name="wait_for_qr_before_start" default="true"/>

  <!-- 基础线段巡线控制 -->
  <!-- 线速度，单位 m/s；正向使用 +linear_speed，倒车使用 -linear_speed。 -->
  <arg name="linear_speed" default="0.85"/>
  <!-- 控制循环频率，单位 Hz；决定 /cmd_vel 发布频率。 -->
  <arg name="control_frequency" default="50.0"/>
  <!-- 正向巡线角速度增益；angular.z = turn_angular_gain * heading_error。 -->
  <arg name="turn_angular_gain" default="1.4"/>
  <!-- 离散 waypoint 前瞻距离，单位 m；从 current_index_+1 往后找第一个离车达到该距离的 waypoint。 -->
  <arg name="lookahead_distance" default="0.5"/>
  <!-- 默认 waypoint 通过半径，单位 m；YAML 单点 pass_radius 可覆盖。 -->
  <arg name="pass_radius" default="1.2"/>
  <!-- 避障结束重定位时，current_index_ 后方参与投影匹配的线段数量；正常巡线只看当前线段。 -->
  <arg name="route_projection_window" default="40"/>
  <!-- 车离候选线段超过该距离时，不用该线段更新路线进度，单位 m。 -->
  <arg name="route_projection_max_distance" default="1.0"/>
  <!-- 投影到线段该比例之后，认为已走到下一段；0.85 表示线段末端前一点就切段。 -->
  <arg name="segment_advance_t" default="0.6"/>

  <!-- 倒车控制 -->
  <!-- 倒车追点角速度增益；倒车时目标方向按车尾计算。 -->
  <arg name="reverse_angular_gain" default="1.1"/>
  <!-- 倒车当前点使用的较短前瞻距离，单位 m，用于避免倒车提前切远点。 -->
  <arg name="reverse_goal_lookahead_distance" default="0.25"/>
  <!-- 默认倒车点通过半径，单位 m，YAML 单点 reverse_pass_radius 可覆盖。 -->
  <arg name="reverse_pass_radius" default="0.25"/>
  <!-- 是否在指定倒车航点附近额外给一个角速度修正。 -->
  <arg name="enable_reverse_approach_nudge" default="true"/>
  <!-- 需要倒车姿态微调的航点编号，从 1 开始。 -->
  <arg name="reverse_approach_nudge_waypoint" default="2"/>
  <!-- 离指定倒车航点小于该距离时开始微调，单位 m。 -->
  <arg name="reverse_approach_nudge_distance" default="0.35"/>
  <!-- 倒车微调角速度，单位 rad/s；正负号决定打角方向。 -->
  <arg name="reverse_approach_nudge_angular_z" default="-0.35"/>

  <!-- 真实雷达矩形通行区避障 -->
  <!-- 是否启用真实雷达避障；启用后在前方矩形区域有障碍时临时接管转向。 -->
  <arg name="enable_obstacle_avoidance" default="true"/>
  <!-- 从哪个航点编号开始启用真实雷达避障；0 表示一开始启用。 -->
  <arg name="obstacle_enable_from_waypoint" default="0"/>
  <!-- 外层减速矩形长度，单位 m；有障碍时只限速，不打避障方向。 -->
  <arg name="slow_corridor_length" default="0.7"/>
  <!-- 外层减速矩形半宽，单位 m。 -->
  <arg name="slow_corridor_half_width" default="0.4"/>
  <!-- 外层减速矩形内至少多少个有效雷达点才减速。 -->
  <arg name="slow_obstacle_min_points" default="1"/>
  <!-- 外层减速触发后的线速度上限，单位 m/s。 -->
  <arg name="slow_linear_speed" default="0.35"/>
  <!-- 方向判断矩形长度，单位 m；只用于判断往左还是往右避，不触发避障。 -->
  <arg name="direction_corridor_length" default="0.7"/>
  <!-- 方向判断矩形半宽，单位 m；建议大于 obstacle/slow 矩形，用来持续看到墙体。 -->
  <arg name="direction_corridor_half_width" default="0.5"/>
  <!-- 内层避障矩形长度，单位 m。 -->
  <arg name="obstacle_corridor_length" default="0.6"/>
  <!-- 内层避障矩形半宽，单位 m；总宽度为该值的 2 倍。 -->
  <arg name="obstacle_corridor_half_width" default="0.3"/>
  <!-- 小于该距离的雷达点忽略，单位 m；用于过滤贴脸噪声。 -->
  <arg name="min_obstacle_range" default="0.05"/>
  <!-- 矩形区内至少多少个有效雷达点才认为有障碍。 -->
  <arg name="obstacle_min_points" default="1"/>
  <!-- 避障时固定打舵角速度，单位 rad/s；障碍在左则取负值，障碍在右则取正值。 -->
  <arg name="avoid_angular_z" default="0.7"/>
  <!-- 避障时线速度，单位 m/s。 -->
  <arg name="avoid_linear_speed" default="0.35"/>
  <!-- 是否用静态地图占用栅格识别墙体点；墙体不触发减速/避障，但会参与避障方向选择。 -->
  <arg name="enable_static_map_obstacle_filter" default="true"/>
  <!-- 地图占用值达到该阈值就认为是墙体/静态障碍，常见地图占用值为 100。 -->
  <arg name="static_map_occupied_threshold" default="50"/>
  <!-- 查询墙体时向周围扩张的栅格数；my_map 分辨率 0.025m 时 4 格约 0.10m。 -->
  <arg name="static_map_inflation_cells" default="8"/>

  <!-- QR 路线选择 -->
  <!-- 环线默认方向；扫码前轨迹不使用该方向，扫到 QR 后由 QR 数字覆盖。 -->
  <arg name="route_direction" default="auto"/>
  <!-- 是否允许 QR 数字在运行中切换顺/逆时针路线。 -->
  <arg name="enable_qr_direction_select" default="true"/>
  <!-- QR 识别结果话题；主线 QR 节点通常发布 /qr_code。 -->
  <arg name="qr_topic" default="/qr_code"/>
  <!-- 收到 QR 并切入航点环线时，是否给 visual_control 发送挂起信号，避免两个节点同时发 /cmd_vel。 -->
  <arg name="suspend_visual_control_on_qr" default="true"/>
  <!-- 环线追点结束后，是否给 visual_control 发送恢复信号，让它接管后续停车。 -->
  <arg name="resume_visual_control_on_finish" default="true"/>
  <!-- visual_control 订阅 /sign4return：收到 5 会挂起，收到 6 会恢复。 -->
  <arg name="visual_control_suspend_topic" default="/sign4return"/>
  <arg name="visual_control_suspend_value" default="5"/>
  <arg name="visual_control_resume_value" default="6"/>
  <!-- true 时奇数 QR=clockwise，偶数 QR=counterclockwise。 -->
  <arg name="use_qr_parity_direction" default="true"/>
  <!-- 不使用奇偶规则时，匹配该数值选择 clockwise。 -->
  <arg name="clockwise_qr_value" default="1"/>
  <!-- 不使用奇偶规则时，匹配该数值选择 counterclockwise。 -->
  <arg name="counterclockwise_qr_value" default="2"/>

  <!-- 是否在经过指定航点或进入指定区域时发布一次图生文/图像分析触发。 -->
  <arg name="enable_image_analysis_trigger" default="true"/>
  <!-- 图生文触发模式：waypoint=按航点编号，region=按 map 坐标圆形区域。 -->
  <arg name="image_analysis_trigger_mode" default="waypoint"/>
  <!-- waypoint 模式下触发图生文/图像分析的航点编号，从 1 开始；region 模式下作为发布给 /sign4return 的编号值。 -->
  <arg name="image_analysis_waypoint" default="8"/>
  <!-- region 模式下的触发区域中心，单位 m，坐标系为 map。 -->
  <arg name="image_analysis_x" default="0.0"/>
  <arg name="image_analysis_y" default="0.0"/>
  <!-- region 模式下的触发半径，单位 m。 -->
  <arg name="image_analysis_radius" default="0.30"/>
  <!-- 图生文/图像分析触发话题；主线 visual_control 监听 /sign4return。 -->
  <arg name="image_analysis_trigger_topic" default="/sign4return"/>

  <node pkg="origincar_system" exec="smooth_path_follower" name="smooth_path_follower" output="screen">
    <param name="waypoints_file" value="$(var waypoints_file)" type="str"/>
    <param name="route_waypoints_file" value="$(var route_waypoints_file)" type="str"/>
    <param name="frame_id" value="$(var frame_id)" type="str"/>
    <param name="base_frame_id" value="$(var base_frame_id)" type="str"/>
    <param name="cmd_vel_topic" value="$(var cmd_vel_topic)" type="str"/>
    <param name="scan_topic" value="$(var scan_topic)" type="str"/>
    <param name="map_topic" value="$(var map_topic)" type="str"/>
    <param name="debug_control_logs" value="$(var debug_control_logs)" type="bool"/>
    <param name="wait_for_qr_before_start" value="$(var wait_for_qr_before_start)" type="bool"/>

    <param name="linear_speed" value="$(var linear_speed)" type="float"/>
    <param name="control_frequency" value="$(var control_frequency)" type="float"/>
    <param name="turn_angular_gain" value="$(var turn_angular_gain)" type="float"/>
    <param name="lookahead_distance" value="$(var lookahead_distance)" type="float"/>
    <param name="pass_radius" value="$(var pass_radius)" type="float"/>
    <param name="route_projection_window" value="$(var route_projection_window)" type="int"/>
    <param name="route_projection_max_distance" value="$(var route_projection_max_distance)" type="float"/>
    <param name="segment_advance_t" value="$(var segment_advance_t)" type="float"/>

    <param name="reverse_angular_gain" value="$(var reverse_angular_gain)" type="float"/>
    <param name="reverse_goal_lookahead_distance" value="$(var reverse_goal_lookahead_distance)" type="float"/>
    <param name="reverse_pass_radius" value="$(var reverse_pass_radius)" type="float"/>
    <param name="enable_reverse_approach_nudge" value="$(var enable_reverse_approach_nudge)" type="bool"/>
    <param name="reverse_approach_nudge_waypoint" value="$(var reverse_approach_nudge_waypoint)" type="int"/>
    <param name="reverse_approach_nudge_distance" value="$(var reverse_approach_nudge_distance)" type="float"/>
    <param name="reverse_approach_nudge_angular_z" value="$(var reverse_approach_nudge_angular_z)" type="float"/>

    <param name="enable_obstacle_avoidance" value="$(var enable_obstacle_avoidance)" type="bool"/>
    <param name="obstacle_enable_from_waypoint" value="$(var obstacle_enable_from_waypoint)" type="int"/>
    <param name="slow_corridor_length" value="$(var slow_corridor_length)" type="float"/>
    <param name="slow_corridor_half_width" value="$(var slow_corridor_half_width)" type="float"/>
    <param name="slow_obstacle_min_points" value="$(var slow_obstacle_min_points)" type="int"/>
    <param name="slow_linear_speed" value="$(var slow_linear_speed)" type="float"/>
    <param name="direction_corridor_length" value="$(var direction_corridor_length)" type="float"/>
    <param name="direction_corridor_half_width" value="$(var direction_corridor_half_width)" type="float"/>
    <param name="obstacle_corridor_length" value="$(var obstacle_corridor_length)" type="float"/>
    <param name="obstacle_corridor_half_width" value="$(var obstacle_corridor_half_width)" type="float"/>
    <param name="min_obstacle_range" value="$(var min_obstacle_range)" type="float"/>
    <param name="obstacle_min_points" value="$(var obstacle_min_points)" type="int"/>
    <param name="avoid_angular_z" value="$(var avoid_angular_z)" type="float"/>
    <param name="avoid_linear_speed" value="$(var avoid_linear_speed)" type="float"/>
    <param name="enable_static_map_obstacle_filter" value="$(var enable_static_map_obstacle_filter)" type="bool"/>
    <param name="static_map_occupied_threshold" value="$(var static_map_occupied_threshold)" type="int"/>
    <param name="static_map_inflation_cells" value="$(var static_map_inflation_cells)" type="int"/>

    <param name="route_direction" value="$(var route_direction)" type="str"/>
    <param name="enable_qr_direction_select" value="$(var enable_qr_direction_select)" type="bool"/>
    <param name="qr_topic" value="$(var qr_topic)" type="str"/>
    <param name="suspend_visual_control_on_qr" value="$(var suspend_visual_control_on_qr)" type="bool"/>
    <param name="resume_visual_control_on_finish" value="$(var resume_visual_control_on_finish)" type="bool"/>
    <param name="visual_control_suspend_topic" value="$(var visual_control_suspend_topic)" type="str"/>
    <param name="visual_control_suspend_value" value="$(var visual_control_suspend_value)" type="int"/>
    <param name="visual_control_resume_value" value="$(var visual_control_resume_value)" type="int"/>
    <param name="use_qr_parity_direction" value="$(var use_qr_parity_direction)" type="bool"/>
    <param name="clockwise_qr_value" value="$(var clockwise_qr_value)" type="int"/>
    <param name="counterclockwise_qr_value" value="$(var counterclockwise_qr_value)" type="int"/>

    <param name="enable_image_analysis_trigger" value="$(var enable_image_analysis_trigger)" type="bool"/>
    <param name="image_analysis_trigger_mode" value="$(var image_analysis_trigger_mode)" type="str"/>
    <param name="image_analysis_waypoint" value="$(var image_analysis_waypoint)" type="int"/>
    <param name="image_analysis_x" value="$(var image_analysis_x)" type="float"/>
    <param name="image_analysis_y" value="$(var image_analysis_y)" type="float"/>
    <param name="image_analysis_radius" value="$(var image_analysis_radius)" type="float"/>
    <param name="image_analysis_trigger_topic" value="$(var image_analysis_trigger_topic)" type="str"/>
  </node>
</launch>
