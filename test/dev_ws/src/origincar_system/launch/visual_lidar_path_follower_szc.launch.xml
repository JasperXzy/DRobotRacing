<launch>
  <!-- SZC 专用逻辑1节点；不要与原 visual_lidar_path_follower 同时启动。 -->
  <arg
    name="params_file"
    default="$(find-pkg-share origincar_system)/config/visual_lidar_path_follower_szc.yaml"/>
  <arg
    name="waypoints_file"
    default="$(find-pkg-share origincar_system)/config/waypoints_qr.yaml"/>
  <arg
    name="route_waypoints_clockwise_file"
    default="$(find-pkg-share origincar_system)/config/waypoints_channel_clockwise.yaml"/>
  <arg
    name="route_waypoints_counterclockwise_file"
    default="$(find-pkg-share origincar_system)/config/waypoints_channel_counterclockwise.yaml"/>

  <node
    pkg="origincar_system"
    exec="visual_lidar_path_follower_szc"
    name="visual_lidar_path_follower_szc"
    output="screen">
    <param from="$(var params_file)"/>
    <param name="waypoints_file" value="$(var waypoints_file)"/>
    <param
      name="route_waypoints_clockwise_file"
      value="$(var route_waypoints_clockwise_file)"/>
    <param
      name="route_waypoints_counterclockwise_file"
      value="$(var route_waypoints_counterclockwise_file)"/>
  </node>

  <node
    pkg="origincar_system"
    exec="szc_route_snapshot_renderer.py"
    name="szc_route_snapshot_renderer"
    output="screen">
    <param from="$(var params_file)"/>
  </node>
</launch>
