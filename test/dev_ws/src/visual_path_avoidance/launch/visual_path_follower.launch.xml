<launch>
  <!-- 独立实验链路：原追点器只算路径速度，本节点用视觉检测做避障后再输出到底盘。 -->
  <arg name="waypoints_file" default="/root/D_Robot/test/dev_ws/src/origincar_system/config/waypoints_qr.yaml"/>
  <arg name="route_waypoints_file" default="/root/D_Robot/test/dev_ws/src/origincar_system/config/waypoints_ysvv_replaced.yaml"/>
  <arg name="path_cmd_vel_topic" default="/visual_path_cmd_vel"/>
  <arg name="output_cmd_vel_topic" default="/cmd_vel"/>
  <arg name="detection_topic" default="/racing_obstacle_detection"/>
  <arg name="handoff_topic" default="/sign4return"/>
  <arg name="debug_control_logs" default="true"/>

  <!-- Visual_Control_README.md：中速_offset线性关系。 -->
  <arg name="linear_speed" default="0.85"/>
  <arg name="avoid_linear_speed" default="0.5"/>
  <arg name="avoid_angular_ratio" default="-0.005"/>
  <arg name="bottom_threshold_caution" default="295"/>
  <arg name="bottom_threshold_avoid" default="305"/>
  <arg name="obstacle_confidence_threshold" default="0.5"/>
  <arg name="delta_x_ratio" default="0.0"/>

  <arg name="path_cmd_timeout" default="0.25"/>
  <arg name="detection_timeout" default="0.30"/>
  <arg name="obstacle_clear_hold_time" default="0.15"/>
  <arg name="path_direction_deadband" default="0.05"/>
  <arg name="active_on_start" default="false"/>

  <include file="$(find-pkg-share origincar_system)/launch/smooth_path_follower.launch.xml">
    <arg name="waypoints_file" value="$(var waypoints_file)"/>
    <arg name="route_waypoints_file" value="$(var route_waypoints_file)"/>
    <arg name="cmd_vel_topic" value="$(var path_cmd_vel_topic)"/>
    <arg name="linear_speed" value="$(var linear_speed)"/>
    <arg name="enable_obstacle_avoidance" value="false"/>
    <arg name="visual_control_suspend_topic" value="$(var handoff_topic)"/>
    <arg name="debug_control_logs" value="$(var debug_control_logs)"/>
  </include>

  <node pkg="visual_path_avoidance" exec="visual_path_avoidance" name="visual_path_avoidance" output="screen">
    <param name="path_cmd_vel_topic" value="$(var path_cmd_vel_topic)" type="str"/>
    <param name="output_cmd_vel_topic" value="$(var output_cmd_vel_topic)" type="str"/>
    <param name="detection_topic" value="$(var detection_topic)" type="str"/>
    <param name="handoff_topic" value="$(var handoff_topic)" type="str"/>
    <param name="active_on_start" value="$(var active_on_start)" type="bool"/>
    <param name="path_cmd_timeout" value="$(var path_cmd_timeout)" type="float"/>
    <param name="detection_timeout" value="$(var detection_timeout)" type="float"/>
    <param name="obstacle_clear_hold_time" value="$(var obstacle_clear_hold_time)" type="float"/>
    <param name="path_direction_deadband" value="$(var path_direction_deadband)" type="float"/>
    <param name="avoid_linear_speed" value="$(var avoid_linear_speed)" type="float"/>
    <param name="avoid_angular_ratio" value="$(var avoid_angular_ratio)" type="float"/>
    <param name="bottom_threshold_caution" value="$(var bottom_threshold_caution)" type="int"/>
    <param name="bottom_threshold_avoid" value="$(var bottom_threshold_avoid)" type="int"/>
    <param name="obstacle_confidence_threshold" value="$(var obstacle_confidence_threshold)" type="float"/>
    <param name="delta_x_ratio" value="$(var delta_x_ratio)" type="float"/>
    <param name="debug_control_logs" value="$(var debug_control_logs)" type="bool"/>
  </node>
</launch>
